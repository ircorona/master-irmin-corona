# Código de clase, tal cual
<IfModule mod_rewrite.c>
    RewriteEngine On
#   RewriteCond %{HTTP_REFERER} !^https://sanchezdonate\.test/ [NC]
    RewriteCond %{HTTP_REFERER} ^https://(www\.)?google\. [NC]
    RewriteCond %{REQUEST_FILENAME} \.(jpg|jpeg|png|gif|webp)$ [NC]
    RewriteRule ^ - [R=204,L]
</IfModule>
